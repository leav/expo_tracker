{
  "name": "vendor-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "copy:sql-wasm": "tsx src/db/copy-sql-wasm.ts",
    "migrations:bundle": "tsx src/db/bundle-migrations.ts",
    "predev": "pnpm copy:sql-wasm && pnpm migrations:bundle",
    "prebuild": "pnpm copy:sql-wasm && pnpm migrations:bundle",
    "pretest": "pnpm migrations:bundle",
    "dev": "next dev --hostname 127.0.0.1 --port 4747",
    "build": "next build",
    "start": "serve out --listen tcp://127.0.0.1:4747",
    "lint": "eslint",
    "test": "tsx --test src/domain/*.test.ts src/lib/*.test.ts src/db/*.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.68.0",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.23.0",
    "sql.js": "^1.16.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sql.js": "^1.4.11",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "serve": "^14.2.7",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.34.9"
}
